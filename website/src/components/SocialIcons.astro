---
// Starlight's social icons, with a Community button before them, so the
// discussions are one click from every page.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { Icon } from '@astrojs/starlight/components';
---

<a href="/community/" class="community-button">
	<Icon name="comment" />
	<span>Community</span>
</a>
<Default />

<style>
	.community-button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.community-button:hover {
		background: var(--sl-color-accent-high);
		color: var(--sl-color-black);
	}
	:global(:root[data-theme='light']) .community-button {
		color: var(--sl-color-white);
	}
	:global(:root[data-theme='light']) .community-button:hover {
		background: var(--sl-color-accent-high);
		color: var(--sl-color-white);
	}
</style>
